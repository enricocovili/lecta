---
import Base from "../../layouts/Base.astro";
import Upload from "../../components/Upload";
import Toasts from "../../components/Toasts";
import { Icon, BrandMark } from "../../components/icons";
---
<Base title="Carica · Lecta" bodyClass="pg-quick-body">
  <header class="topbar pg-quick-top">
    <a class="brand" href="/admin"><BrandMark />Lecta</a>
    <span class="spacer"></span>
    <button class="btn ghost icon" data-theme-toggle type="button" aria-label="Cambia tema" title="Tema chiaro / scuro">
      <Icon name="moon" className="i-moon" /><Icon name="sun" className="i-sun" />
    </button>
    <a class="btn sm" href="/admin"><Icon name="home" />Area di lavoro</a>
  </header>
  <main class="pg-quick-main">
    <h1>Carica</h1>
    <p class="pg-quick-sub">Fotografa i tuoi appunti (anche più pagine insieme) o scegli dei file. Se non indichi la materia, Lecta la smista per te.</p>
    <Upload client:load quick />
  </main>
  <Toasts client:load />
</Base>
