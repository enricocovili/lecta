---
import Workspace from "../../../../../layouts/Workspace.astro";
import LessonEditor from "../../../../../components/lessons/LessonEditor";
import { backendGet } from "../../../../../lib/server";
const courseId = Number(Astro.params.id);
const number = Number(Astro.params.n);
const r = await backendGet<{ title: string }>(Astro, `/api/courses/${courseId}/lessons/${number}?pages=false`);
if (!r.data) return Astro.rewrite("/404");
---
<Workspace title={r.data.title}>
  <LessonEditor client:only="react" courseId={courseId} number={number} />
</Workspace>
