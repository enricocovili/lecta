---
import Public from "../../layouts/Public.astro";
import Reader from "../../components/public/Reader";
import { Icon } from "../../components/icons";
import { backendGet } from "../../lib/server";
import { pagesIt, sizeIt, type PubChapter, type PubCourse } from "../../components/public/format";
const { slug } = Astro.params;
const r = await backendGet<PubCourse & { chapters: PubChapter[] }>(Astro, `/api/public/courses/${encodeURIComponent(slug ?? "")}`);
if (!r.data) return Astro.rewrite("/404");
const c = r.data;
// The fallback slot renders without JavaScript (and while the reader loads): same frame, plain links to the PDFs.
const mode = Astro.url.searchParams.get("mode") === "slides" ? "slides" : "doc";
---
<Public title={c.name} app>
  <Reader client:only="react" course={c} initialMode={mode}>
    <div slot="fallback" class="pub-reader">
      <header class="pub-rbar">
        <div class="pub-rbar-left">
          <a class="pub-back" href="/" aria-label="Torna alle materie"><Icon name="arrow-left" /><span class="hide-mobile">Materie</span></a>
          <span class="pub-rbar-div hide-mobile"></span>
          <div class="pub-rtitle">
            <div class="pub-rname">{c.name}</div>
            <div class="pub-rchap">{c.chapters.length} capitoli</div>
          </div>
        </div>
        <span></span>
        <div class="pub-rbar-right">
          <button class="btn ghost icon" data-theme-toggle type="button" aria-label="Cambia tema" title="Tema chiaro / scuro">
            <Icon name="moon" className="i-moon" /><Icon name="sun" className="i-sun" />
          </button>
          {c.source_url && (
            <a class="btn pub-dl" href={c.source_url} download={`${c.slug}-latex.zip`} aria-label="Scarica sorgente LaTeX" title="Sorgente LaTeX (.zip)">
              <Icon name="code" /><span class="hide-mobile">Scarica sorgente LaTeX</span>
            </a>
          )}
          <a class="btn primary pub-dl" href={c.pdf_url} download={`${c.slug}.pdf`} aria-label="Scarica PDF">
            <Icon name="download" /><span class="hide-mobile">Scarica PDF</span>
          </a>
        </div>
      </header>
      <div class="pub-rbody">
        <aside class="pub-index pub-index-static" aria-label="Indice">
          <div class="pub-index-scroll">
            <div class="pub-side-label">Indice</div>
            <ol class="pub-toc">
              {c.chapters.map((ch) => (
                <li id={`ch-${ch.slug}`}>
                  <a href={ch.pdf_url ?? (ch.page_start ? `${c.pdf_url}#page=${ch.page_start}` : c.pdf_url)}>
                    <span class="n">{ch.position}</span>
                    <span class="t">{ch.title}</span>
                    <span class="p">{ch.page_start ?? ""}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
          <div class="pub-downloads">
            <div class="pub-side-label">Download</div>
            <a href={c.pdf_url} download={`${c.slug}.pdf`}>
              <Icon name="download" /><span class="t">Corso completo</span><span class="p">PDF · {sizeIt(c.pdf_size)}</span>
            </a>
            {c.source_url && (
              <a href={c.source_url} download={`${c.slug}-latex.zip`}>
                <Icon name="code" /><span class="t">Sorgente LaTeX</span><span class="p">ZIP{c.source_size ? ` · ${sizeIt(c.source_size)}` : ""}</span>
              </a>
            )}
          </div>
        </aside>
        <main class="pub-stage">
          <div class="pub-stage-msg">
            <p class="muted">Caricamento del documento…</p>
            <a class="btn" href={c.pdf_url}><Icon name="external" />Apri il PDF</a>
            {c.source_url && <a class="btn" href={c.source_url} download={`${c.slug}-latex.zip`}><Icon name="code" />Scarica sorgente LaTeX</a>}
            <ul class="pub-fallback-list">
              {c.chapters.map((ch) => (
                <li>
                  {ch.pdf_url ? <a href={ch.pdf_url}>{ch.position}. {ch.title}</a> : <span>{ch.position}. {ch.title}</span>}
                  <span class="muted small"> {pagesIt(ch)}</span>
                </li>
              ))}
            </ul>
          </div>
        </main>
      </div>
    </div>
  </Reader>
</Public>
